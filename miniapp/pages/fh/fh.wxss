/* .poem* / .hero* / .actbar / .cta / .chip 已提到 app.wxss。 */

/* ---------- 取字卡 ---------- */
.grab {
    padding: var(--s-6) var(--s-5) var(--s-5);
}

/* 大字输入，像在格子里落一笔 */
.grab__input {
    height: 136rpx;
    text-align: center;
    font-size: 72rpx;
    letter-spacing: 4rpx;
    color: var(--ink);
    border-bottom: 2rpx solid var(--line);
    margin-bottom: var(--s-4);
}
/* placeholder 是原生伪元素，不保证继承 CSS 变量，写死色值；深色下另给一套 */
.grab__ph {
    font-size: var(--t-sm);
    letter-spacing: 2rpx;
    color: #766D6A;
}
.t-dark .grab__ph { color: #8E8786; }

/* 固定 4 列。用 flex-wrap 会按剩余宽度排出 5+3 这种不齐的行 */
.grab__quick {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    justify-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
}

/* ---------- 结果卡 ---------- */
.result { margin-top: var(--s-4); }

.result__hit {
    margin-top: var(--s-4);
    text-align: center;
    font-size: var(--t-cap);
    color: var(--ink-3);
}
