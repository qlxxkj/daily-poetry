.block { margin-top: 16rpx; }
.label { font-size: 26rpx; color: #8a90a0; margin-bottom: 16rpx; }
.row { display: flex; gap: 16rpx; }
.input { flex: 1; background: #1a1d24; border: 1rpx solid #2a2f3a; border-radius: 12rpx; padding: 20rpx; color: #e8ebf2; font-size: 32rpx; }
.btn { background: #3a6cff; color: #fff; font-size: 28rpx; border-radius: 12rpx; padding: 0 40rpx; }
.btn--ghost { background: #232a38; color: #cfd4e0; font-size: 26rpx; margin-top: 20rpx; }
.quick { display: flex; gap: 14rpx; margin-top: 20rpx; flex-wrap: wrap; }
.q { background: #232a38; color: #cfd4e0; font-size: 26rpx; padding: 10rpx 24rpx; border-radius: 24rpx; }
.card { background: #141821; border: 1rpx solid #232a38; border-radius: 20rpx; padding: 36rpx; margin-top: 28rpx; }
.meta { display: flex; gap: 16rpx; font-size: 22rpx; color: #8a90a0; }
.dynasty { color: #4cd78b; } .author { color: #cfd4e0; }
.title { font-size: 32rpx; margin: 12rpx 0 16rpx; font-weight: 600; }
.body { text-align: center; } .line { font-size: 30rpx; line-height: 1.9; color: #dfe3ec; }
.hit { margin-top: 20rpx; font-size: 22rpx; color: #5a6070; }
.card .btn { margin-top: 24rpx; }
.err { margin-top: 24rpx; color: #ff6b6b; font-size: 26rpx; }
