.row { display: flex; gap: 16rpx; }
.input { flex: 1; background: #1a1d24; border: 1rpx solid #2a2f3a; border-radius: 12rpx; padding: 20rpx; color: #e8ebf2; font-size: 28rpx; }
.btn { background: #3a6cff; color: #fff; font-size: 28rpx; border-radius: 12rpx; padding: 0 32rpx; }
.btn--ghost { background: #232a38; color: #cfd4e0; font-size: 24rpx; margin-top: 20rpx; }
.count { margin-top: 24rpx; color: #5a6070; font-size: 24rpx; }
.card { background: #141821; border: 1rpx solid #232a38; border-radius: 16rpx; padding: 28rpx; margin-top: 20rpx; }
.meta { display: flex; gap: 16rpx; font-size: 22rpx; color: #8a90a0; }
.dynasty { color: #4cd78b; } .author { color: #cfd4e0; } .type { color: #5a6070; }
.title { font-size: 32rpx; margin: 12rpx 0 16rpx; font-weight: 600; }
.body { font-size: 28rpx; line-height: 1.8; color: #dfe3ec; white-space: pre-wrap; }
.ph { margin-top: 80rpx; text-align: center; color: #5a6070; }
.err { margin-top: 24rpx; color: #ff6b6b; font-size: 26rpx; }
