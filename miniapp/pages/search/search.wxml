<view class="page">
    <view class="row">
        <input class="input" placeholder="搜诗 / 作者 / 朝代,如「静夜思」" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="doSearch" />
        <button class="btn" loading="{{loading}}" bindtap="doSearch">检索</button>
    </view>
    <view wx:if="{{results.length}}" class="count">共 {{results.length}} 首</view>
    <view wx:for="{{results}}" wx:key="id" class="card" data-poem="{{item}}">
        <view class="meta">
            <text class="dynasty">{{item.dynasty}}</text>
            <text class="author">{{item.author}}</text>
            <text class="type">{{item.type}}</text>
        </view>
        <view class="title">{{item.title}}</view>
        <view class="body">{{item.content}}</view>
        <button class="btn btn--ghost" data-poem="{{item}}" bindtap="onCopy">复制</button>
        <button class="btn btn--ghost" data-poem="{{item}}" bindtap="onDetail">详情</button>
    </view>
    <view wx:if="{{!results.length && !loading && !error}}" class="ph">输入关键词检索 37 万首</view>
    <view wx:if="{{error}}" class="err">{{error}}</view>
</view>
