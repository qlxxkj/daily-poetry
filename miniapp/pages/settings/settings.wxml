<view class="page">
    <view class="block">
        <view class="label">古诗词 API 地址</view>
        <view class="hint">{{apiBase}}</view>
    </view>

    <view class="block">
        <view class="label">文字</view>
        <view class="row">
            <view class="opt {{lang==='zh-Hans'?'opt--on':''}}" data-lang="zh-Hans" bindtap="setLang">简体</view>
            <view class="opt {{lang==='zh-Hant'?'opt--on':''}}" data-lang="zh-Hant" bindtap="setLang">繁体</view>
        </view>
    </view>

    <button class="btn btn--ghost" loading="{{testing}}" bindtap="test">测试连接</button>
    <view wx:if="{{testResult}}" class="{{testResult[0]==='连'?'ok':'err'}}">{{testResult}}</view>
</view>
