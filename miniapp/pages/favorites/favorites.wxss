/* 收藏列表用的就是查询页那套条目结构，这里只补空态。 */

.item {
    margin-top: var(--s-3);
    padding: var(--s-4) var(--s-4) var(--s-2);
    transition: background var(--dur-1) var(--ease);
}
.item:active { background: var(--fill); }

.item__head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
}
.item__title {
    flex: 1;
    min-width: 0;
    font-size: var(--t-title);
    font-weight: 600;
    letter-spacing: 1rpx;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.item__meta {
    margin-top: var(--s-1);
    font-size: var(--t-cap);
    color: var(--ink-3);
}
.item__body {
    margin-top: var(--s-2);
    font-size: var(--t-body);
    line-height: 1.8;
    color: var(--ink);
    white-space: pre-wrap;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
}
.item__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--s-2);
    border-top: 1rpx solid var(--line);
}
.item__acts { display: flex; gap: var(--s-3); }
.item__act {
    display: flex;
    align-items: center;
    min-height: 80rpx;
    padding: 0 var(--s-3);
    margin-left: calc(var(--s-3) * -1);
    border-radius: var(--r-sm);
    font-size: var(--t-cap);
    color: var(--ink-2);
    transition: background var(--dur-1) var(--ease);
}
.item__act:active { background: var(--fill-2); }
.item__act--on { color: var(--accent); }
.item__act-ic { width: 30rpx; height: 30rpx; margin-right: var(--s-1); }
.item__arrow { width: 32rpx; height: 32rpx; }

/* ---------- 空态 ---------- */
.state__hint {
    margin-top: var(--s-2);
    font-size: var(--t-cap);
    color: var(--ink-3);
    opacity: 0.8;
}
.state__btn {
    display: inline-flex;
    margin-top: var(--s-5);
    padding: 0 var(--s-5);
}
