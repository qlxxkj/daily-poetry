.placeholder { margin-top: 120rpx; text-align: center; }
.ph-title { font-size: 44rpx; color: #8a90a0; margin-bottom: 32rpx; }
.card {
    background: #141821; border: 1rpx solid #232a38; border-radius: 20rpx;
    padding: 40rpx 36rpx; margin-top: 24rpx;
}
.meta { display: flex; align-items: center; gap: 16rpx; font-size: 24rpx; color: #8a90a0; }
.dynasty { color: #4cd78b; }
.author { color: #cfd4e0; }
.type { color: #5a6070; }
.title { font-size: 34rpx; color: #e8ebf2; margin: 20rpx 0 28rpx; font-weight: 600; }
.body { text-align: center; }
.line { font-size: 32rpx; line-height: 1.9; color: #dfe3ec; letter-spacing: 2rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 40rpx; flex-wrap: wrap; }
.btn { flex: 1; min-width: 160rpx; background: #3a6cff; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.btn--ghost { background: #232a38; color: #cfd4e0; }
.err { margin-top: 32rpx; color: #ff6b6b; font-size: 26rpx; }
