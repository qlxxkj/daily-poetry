/* .poem* / .actbar / .btn 等通用件已提到 app.wxss，首页只留自己特有的部分。 */

/* 页头：一行，左边日期，右边简繁分段控件。不再有大标题抢诗词的视觉重量 */
.daybar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-1) 0 var(--s-5);
}
.daybar__date {
    font-size: var(--t-cap);
    letter-spacing: 3rpx;
    color: var(--ink-3);
}

/* ---------- 空态 ---------- */
.welcome {
    padding: 96rpx 0 0;
    text-align: center;
}
/* 朱砂印章，替掉原来干巴巴的标题 */
.welcome__seal {
    width: 144rpx;
    height: 144rpx;
    margin: 0 auto var(--s-5);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-lg);
    background: var(--accent);
    color: var(--on-solid);
    font-size: 68rpx;
    line-height: 1;
    box-shadow: 0 10rpx 28rpx rgba(165, 73, 43, 0.2);
}
.welcome__desc {
    margin-bottom: var(--s-6);
    font-size: var(--t-sm);
    color: var(--ink-3);
}

/* ---------- 「再抽一首」加载动效 ----------
   点按钮后数据没回来前，按钮变 loading 态：文字旁转圈，
   避免用户以为点了没反应。disabled 保持原样式，只靠动效提示。 */
.btn--loading {
    gap: 12rpx;
}
.btn__spinner {
    width: 28rpx;
    height: 28rpx;
    border-radius: 50%;
    flex-shrink: 0;
    border: 3rpx solid rgba(255, 255, 255, 0.35);
    border-top-color: var(--on-solid, #fff);
    animation: btn-spin 0.7s linear infinite;
}
@keyframes btn-spin {
    to { transform: rotate(360deg); }
}
