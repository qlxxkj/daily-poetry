<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>编辑 #<%= p.id %> · 管理</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
<%- include("../_nav.ejs", { active: "poems" }) %>
<main class="container">

<% if (flash === "saved") { %><div class="toast toast--ok">已保存</div><% } %>

<div class="page-head">
    <h1>编辑诗词 #<%= p.id %></h1>
    <p class="sub"><%= p.author_name || "佚名" %> · <%= p.dynasty_name || "朝代未知" %></p>
</div>

<form method="post" action="/poems/<%= p.id %>" class="form">

    <div class="form-grid">
        <div class="form-row">
            <label>标题</label>
            <input type="text" name="title" value="<%= p.title %>" class="input">
        </div>

        <div class="form-row">
            <label>作者</label>
            <div class="form-combo">
                <select name="author_id" class="input" id="author_sel">
                    <option value="">— 无 —</option>
                    <% authors.forEach(a => { %>
                        <option value="<%= a.id %>" <%= a.id == p.author_id ? "selected" : "" %>><%= a.name %></option>
                    <% }) %>
                </select>
                <input type="text" class="input input--short" placeholder="搜索作者ID" id="author_search">
            </div>
            <p class="form-hint">可输入作者 ID 直接填入（如已知），或从下拉选择</p>
        </div>

        <div class="form-row">
            <label>朝代</label>
            <select name="dynasty_id" class="input">
                <option value="">— 无 —</option>
                <% dynasties.forEach(d => { %>
                    <option value="<%= d.id %>" <%= d.id == p.dynasty_id ? "selected" : "" %>><%= d.name %></option>
                <% }) %>
            </select>
        </div>

        <div class="form-row">
            <label>类型</label>
            <select name="type_id" class="input">
                <option value="">— 无 —</option>
                <% types.forEach(t => { %>
                    <option value="<%= t.id %>" <%= t.id == p.type_id ? "selected" : "" %>><%= t.name %></option>
                <% }) %>
            </select>
        </div>
    </div>

    <hr class="hr">
    <h3>内容（每行一句）</h3>
<% let contentLines; try { contentLines = JSON.parse(p.content || "[]").join("\n"); } catch(e) { contentLines = p.content || ""; } %>
    <textarea name="content" rows="10" class="input textarea--poem"
      placeholder="床前明月光&#10;疑是地上霜&#10;举头望明月&#10;低头思故乡"><%= contentLines %></textarea>

    <hr class="hr">
    <h3>扩展字段</h3>
    <div class="form-grid">
        <div class="form-row">
            <label>音频 URL</label>
            <input type="url" name="audio_url" value="<%= p.audio_url %>" class="input" placeholder="https://…">
        </div>
        <div class="form-row">
            <label>视频 URL（可选）</label>
            <input type="url" name="video_url" value="<%= p.video_url %>" class="input" placeholder="https://…">
        </div>
        <div class="form-row">
            <label>插图 URL（可选）</label>
            <input type="url" name="illustration_url" value="<%= p.illustration_url %>" class="input" placeholder="https://…">
        </div>
    </div>

    <div class="form-row">
        <label>释义 / 鉴赏</label>
        <textarea name="explanation" rows="6" class="input textarea" placeholder="此处填写诗词释义、赏析等内容…"><%= p.explanation %></textarea>
    </div>

    <div class="form-actions">
        <a href="/poems" class="btn btn--ghost">← 返回列表</a>
        <button type="submit" class="btn btn--primary">保存</button>
    </div>
</form>
</main>
<script src="/public/app.js"></script>
</body>
</html>
