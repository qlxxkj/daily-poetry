<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== "undefined" ? title + " · " : "" %>诗词管理</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
<% if (typeof authed !== "undefined" && authed) { %>
<nav class="nav">
    <a href="/" class="nav__logo">诗词管理</a>
    <div class="nav__links">
        <a href="/poems" class="<%= typeof active !== 'undefined' && active === 'poems' ? 'on' : '' %>">诗词</a>
        <a href="/authors" class="<%= typeof active !== 'undefined' && active === 'authors' ? 'on' : '' %>">作者</a>
    </div>
    <form method="post" action="/logout" class="nav__logout">
        <button type="submit" class="btn-ghost">退出</button>
    </form>
</nav>
<% } %>
<main class="container">
<%- body %>
</main>
<script src="/public/app.js"></script>
</body>
</html>
