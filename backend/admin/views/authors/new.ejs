<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>新建作者 · 管理</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
<%- include("../_nav.ejs", { active: "authors" }) %>
<main class="container">
<div class="page-head">
    <h1>新建作者</h1>
</div>
<form method="post" action="/authors/new" class="form">
    <div class="form-row">
        <label>姓名</label>
        <input type="text" name="name" class="input" required autofocus>
    </div>
    <div class="form-row">
        <label>朝代</label>
        <select name="dynasty_id" class="input">
            <option value="">— 无 —</option>
            <% dynasties.forEach(d => { %>
                <option value="<%= d.id %>"><%= d.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-row">
        <label>简介（可选）</label>
        <textarea name="description" rows="4" class="input textarea"></textarea>
    </div>
    <div class="form-actions">
        <a href="/authors" class="btn btn--ghost">取消</a>
        <button type="submit" class="btn btn--primary">创建</button>
    </div>
</form>
</main>
<script src="/public/app.js"></script>
</body>
</html>
